<?xml version="1.0" encoding="UTF-8"?>
<labwc_config>
  <core>
    <decoration>server</decoration>
    <gap>6</gap>
    <reuseOutputMode>yes</reuseOutputMode>
  </core>

  <placement>
    <policy>Smart</policy>
    <cascadeOffset x="28" y="28" />
  </placement>

  <theme>
    <name>Iron</name>
    <cornerRadius>4</cornerRadius>
    <font name="Inter" size="10" />
  </theme>

  <focus>
    <focusNew>yes</focusNew>
    <followMouse>no</followMouse>
    <raiseOnFocus>no</raiseOnFocus>
  </focus>

  <snapping>
    <range>12</range>
    <topMaximize>yes</topMaximize>
  </snapping>

  <windowSwitcher>
    <fields>
      <field content="type" width="20%" />
      <field content="title" width="80%" />
    </fields>
  </windowSwitcher>

  <desktops number="4">
    <popupTime>800</popupTime>
    <names>
      <name>1</name>
      <name>2</name>
      <name>3</name>
      <name>4</name>
    </names>
  </desktops>

  <keyboard>
    <keybind key="W-Return">
      <action name="Execute" command="foot" />
    </keybind>
    <keybind key="W-d">
      <action name="Execute" command="fuzzel" />
    </keybind>
    <keybind key="W-Space">
      <action name="ShowMenu" menu="root-menu" />
    </keybind>
    <keybind key="W-e">
      <action name="Execute" command="pcmanfm" />
    </keybind>
    <keybind key="W-i">
      <action name="Execute" command="iron-installer" />
    </keybind>
    <keybind key="W-s">
      <action name="Execute" command="iron-settings" />
    </keybind>
    <keybind key="W-b">
      <action name="Execute" command="firefox-esr" />
    </keybind>
    <keybind key="W-v">
      <action name="Execute" command="iron-clipboard-menu" />
    </keybind>
    <keybind key="Print">
      <action name="Execute" command="iron-screenshot full" />
    </keybind>
    <keybind key="S-Print">
      <action name="Execute" command="iron-screenshot region" />
    </keybind>
    <keybind key="W-l">
      <action name="Execute" command="swaylock -f -c 111315" />
    </keybind>
    <keybind key="W-x">
      <action name="Execute" command="iron-power-menu" />
    </keybind>
    <keybind key="A-Tab">
      <action name="NextWindow" />
    </keybind>
    <keybind key="A-S-Tab">
      <action name="PreviousWindow" />
    </keybind>
    <keybind key="W-Left">
      <action name="SnapToEdge" direction="left" />
    </keybind>
    <keybind key="W-Right">
      <action name="SnapToEdge" direction="right" />
    </keybind>
    <keybind key="W-Up">
      <action name="Maximize" />
    </keybind>
    <keybind key="W-Down">
      <action name="UnMaximize" />
    </keybind>
    <keybind key="W-q">
      <action name="Close" />
    </keybind>
    <keybind key="W-S-c">
      <action name="Reconfigure" />
    </keybind>
    <keybind key="XF86AudioRaiseVolume">
      <action name="Execute" command="iron-volume up" />
    </keybind>
    <keybind key="XF86AudioLowerVolume">
      <action name="Execute" command="iron-volume down" />
    </keybind>
    <keybind key="XF86AudioMute">
      <action name="Execute" command="iron-volume mute" />
    </keybind>
    <keybind key="XF86MonBrightnessUp">
      <action name="Execute" command="brightnessctl set +10%" />
    </keybind>
    <keybind key="XF86MonBrightnessDown">
      <action name="Execute" command="brightnessctl set 10%-" />
    </keybind>
    <keybind key="W-1">
      <action name="GoToDesktop" to="1" />
    </keybind>
    <keybind key="W-2">
      <action name="GoToDesktop" to="2" />
    </keybind>
    <keybind key="W-3">
      <action name="GoToDesktop" to="3" />
    </keybind>
    <keybind key="W-4">
      <action name="GoToDesktop" to="4" />
    </keybind>
    <keybind key="W-S-1">
      <action name="SendToDesktop" to="1" />
    </keybind>
    <keybind key="W-S-2">
      <action name="SendToDesktop" to="2" />
    </keybind>
    <keybind key="W-S-3">
      <action name="SendToDesktop" to="3" />
    </keybind>
    <keybind key="W-S-4">
      <action name="SendToDesktop" to="4" />
    </keybind>
  </keyboard>

  <mouse>
    <context name="Root">
      <mousebind button="Right" action="Press">
        <action name="ShowMenu" menu="root-menu" />
      </mousebind>
      <mousebind button="Middle" action="Press">
        <action name="Execute" command="fuzzel" />
      </mousebind>
    </context>
    <context name="Titlebar">
      <mousebind button="Left" action="Drag">
        <action name="Move" />
      </mousebind>
      <mousebind button="Left" action="DoubleClick">
        <action name="ToggleMaximize" />
      </mousebind>
    </context>
    <context name="Frame">
      <mousebind button="Left" action="Drag">
        <action name="Resize" />
      </mousebind>
    </context>
  </mouse>
</labwc_config>
