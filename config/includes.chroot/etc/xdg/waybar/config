{
  "layer": "top",
  "position": "top",
  "height": 34,
  "spacing": 8,
  "margin-top": 0,
  "margin-left": 0,
  "margin-right": 0,
  "modules-left": ["custom/launcher", "wlr/workspaces", "wlr/taskbar"],
  "modules-center": ["clock"],
  "modules-right": ["custom/install", "tray", "network", "bluetooth", "pulseaudio", "battery", "custom/power"],
  "custom/launcher": {
    "format": "Iron",
    "tooltip": false,
    "on-click": "fuzzel"
  },
  "custom/install": {
    "format": "Install Iron Linux",
    "tooltip": false,
    "on-click": "iron-installer"
  },
  "wlr/workspaces": {
    "format": "{name}",
    "on-click": "activate",
    "sort-by-number": true
  },
  "wlr/taskbar": {
    "format": "{icon}",
    "icon-size": 18,
    "tooltip-format": "{title}",
    "on-click": "activate",
    "on-click-middle": "close",
    "all-outputs": true
  },
  "clock": {
    "format": "{:%a %d %b  %H:%M}",
    "tooltip-format": "{:%A, %d %B %Y}"
  },
  "network": {
    "format-wifi": "{essid}",
    "format-ethernet": "Wired",
    "format-disconnected": "Offline",
    "tooltip-format": "{ifname}",
    "on-click": "nm-connection-editor"
  },
  "bluetooth": {
    "format": "",
    "format-disabled": "",
    "format-connected": " {num_connections}",
    "tooltip-format": "{controller_alias}: {controller_address}",
    "tooltip-format-connected": "{controller_alias}: {controller_address}\n{device_enumerate}",
    "on-click": "blueman-manager"
  },
  "pulseaudio": {
    "format": "{volume}%",
    "format-muted": "Muted",
    "on-click": "iron-volume mute",
    "on-scroll-up": "iron-volume up",
    "on-scroll-down": "iron-volume down"
  },
  "battery": {
    "format": "{capacity}%",
    "format-charging": "{capacity}% AC",
    "states": {
      "warning": 25,
      "critical": 12
    }
  },
  "tray": {
    "icon-size": 16,
    "spacing": 8
  },
  "custom/power": {
    "format": "Power",
    "tooltip": false,
    "on-click": "iron-power-menu"
  }
}
