#!/bin/bash
# Iron Linux override of calamares-settings-debian's bootloader-config
# helper (same path, takes precedence via includes.chroot).
#
# Root cause, found by actually running the installer end-to-end in QEMU
# (both BIOS and UEFI code paths, both reproduced): the upstream script
# unconditionally runs `apt-get install grub-pc` (BIOS) or
# `apt-get install grub-efi` (UEFI) inside the target. Neither package
# exists on Debian trixie any more - `apt-cache policy grub-pc grub-efi`
# shows "Candidate: (none)" for both. What actually exists and does the
# real work is grub-pc-bin/grub2-common/grub-common (BIOS) and
# grub-efi-amd64-bin/grub-efi-amd64-signed (UEFI) - packages Iron Linux
# already ships (see package-lists/live.list.chroot and desktop's
# bootloader needs), so they are already installed in the target via
# unpackfs before this script ever runs. The upstream apt-get call was
# never actually necessary for Iron Linux; it just crashed the installer
# with "Package grub-pc is not available" instead of being a no-op.
CHROOT=$(mount | grep proc | grep calamares | awk '{print $3}' | sed -e "s#/proc##g")

# Install luks utilities if needed, and set secure initramfs permissions
# for full-disk-encryption (the initramfs itself is regenerated later).
if [ "$(mount | grep $CHROOT" " | cut -c -16)" = "/dev/mapper/luks" ]; then
    echo "UMASK=0077" > $CHROOT/etc/initramfs-tools/conf.d/initramfs-permissions
    chroot $CHROOT apt-get -y install cryptsetup-initramfs cryptsetup keyutils
fi

echo "Running bootloader-config..."

if [ -d /sys/firmware/efi/efivars ]; then
    echo " * install grub-efi-amd64-bin (uefi)..."
    DEBIAN_FRONTEND=noninteractive chroot $CHROOT apt-get -y install grub-efi-amd64-bin
else
    echo " * install grub-pc-bin (bios)..."
    DEBIAN_FRONTEND=noninteractive chroot $CHROOT apt-get -y install grub-pc-bin
fi

# grub2-common's postinst is what normally creates /etc/default/grub
# (from its /usr/share/grub/default/grub template) and /boot/grub/, but
# it deliberately skips that when it detects it's running inside a
# chroot during automated package installation (exactly what live-build
# does when assembling the squashfs) - it defers the real setup to
# grub-install/update-grub being run for real, later, against an actual
# target. That "later" is here. Without this, `sed` below has no file to
# edit and grub-mkconfig has no directory to write into - found by
# actually running the installer to completion in QEMU.
if [ ! -f "$CHROOT/etc/default/grub" ] && [ -f "$CHROOT/usr/share/grub/default/grub" ]; then
    cp "$CHROOT/usr/share/grub/default/grub" "$CHROOT/etc/default/grub"
fi
mkdir -p "$CHROOT/boot/grub"

# Re-enable os-prober:
sed -i "s/#GRUB_DISABLE_OS_PROBER=false/# OS_PROBER re-enabled by Debian Calamares installation:\nGRUB_DISABLE_OS_PROBER=false/g" $CHROOT/etc/default/grub
chroot $CHROOT /usr/sbin/update-grub
