# Iron Linux Plymouth Boot Splash Script
# Visual Identity: Graphite / Dark Iron (#111315) with industrial precision

# Screen geometry
screen_width = Window.GetWidth();
screen_height = Window.GetHeight();

# Background color (#111315 -> RGB: 0.067, 0.075, 0.082)
Window.SetBackgroundTopColor(0.067, 0.075, 0.082);
Window.SetBackgroundBottomColor(0.067, 0.075, 0.082);

# Splash logo image
raw_splash = Image("plymouth-splash.png");
splash_w = raw_splash.GetWidth();
splash_h = raw_splash.GetHeight();

# Scale or fit to screen
if (screen_width > 0 && screen_height > 0) {
    if (splash_w != screen_width || splash_h != screen_height) {
        # Scale to match display resolution while keeping aspect ratio or screen bounds
        splash_image = raw_splash.Scale(screen_width, screen_height);
    } else {
        splash_image = raw_splash;
    }
} else {
    splash_image = raw_splash;
}

splash_sprite = Sprite(splash_image);
splash_sprite.SetX(Window.GetX() + (Window.GetWidth() - splash_image.GetWidth()) / 2);
splash_sprite.SetY(Window.GetY() + (Window.GetHeight() - splash_image.GetHeight()) / 2);
splash_sprite.SetZ(0);
splash_sprite.SetOpacity(1.0);

# Messages / status text
message_sprite = Sprite();
message_sprite.SetPosition(Window.GetX() + 32, Window.GetY() + Window.GetHeight() - 48, 100);

fun display_message_callback (text)
{
    my_image = Image.Text(text, 0.84, 0.86, 0.88);
    message_sprite.SetImage(my_image);
}

fun hide_message_callback (text)
{
    message_sprite.SetImage(Image());
}

# Password prompt callback (e.g. disk decryption)
fun display_password_callback (prompt, bullets)
{
    prompt_text = prompt;
    for (i = 0; i < bullets; i++)
    {
        prompt_text += "*";
    }
    prompt_image = Image.Text(prompt_text, 0.84, 0.86, 0.88);
    message_sprite.SetImage(prompt_image);
}

fun refresh_callback ()
{
    # Maintain display state
}

fun quit_callback ()
{
    splash_sprite.SetOpacity(1.0);
}

Plymouth.SetRefreshFunction(refresh_callback);
Plymouth.SetDisplayMessageFunction(display_message_callback);
Plymouth.SetHideMessageFunction(hide_message_callback);
Plymouth.SetDisplayPasswordFunction(display_password_callback);
Plymouth.SetQuitFunction(quit_callback);
