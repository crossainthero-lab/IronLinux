#!/bin/sh
# Compatibility shim: the real launcher logic lives in /usr/local/bin/iron-installer
# (used by the Labwc menu, keyboard shortcut, and Waybar launcher button).
# This name is kept because calamares-settings-debian's stock
# "Install Debian" launcher (/usr/bin/calamares-install-debian) execs it.
set -eu
exec iron-installer "$@"
