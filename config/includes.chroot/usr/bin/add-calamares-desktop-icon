#!/bin/sh
set -eu

desktop_dir="${XDG_DESKTOP_DIR:-}"
if [ -z "$desktop_dir" ] && command -v xdg-user-dir >/dev/null 2>&1; then
    desktop_dir="$(xdg-user-dir DESKTOP)"
fi
desktop_dir="${desktop_dir:-$HOME/Desktop}"

mkdir -p "$desktop_dir"
cp /usr/share/applications/calamares-install-iron.desktop "$desktop_dir/calamares-install-iron.desktop"
chmod +x "$desktop_dir/calamares-install-iron.desktop"

if command -v ionice >/dev/null 2>&1; then
    ionice -c 3 cat /usr/bin/calamares >/dev/null 2>&1 || true
fi
