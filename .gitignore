# Iron Linux - live-build artifacts and local build state.
# Everything under here is regenerated by ./build.sh / lb config / lb build
# and must never be committed.

# live-build working directories (created by `lb config`)
/config/binary
/config/bootstrap
/config/chroot
/config/common
/config/source
/config/rootfs

# live-build build/output directories (created by `lb build`)
/.build/
/cache/
/chroot/
/chroot.*/
/chroot.packages.*
/binary/
/binary.*
/local/

# ISO / image output
*.iso
# Oversized backup image; keep it local and out of Git history.
/build-artifacts/iron-linux-amd64.with-backup.iso
*.img
*.img.xz
*.qcow2
*.qcow2.xz
*.squashfs*
*.zsync
*.contents
*.files
*.packages
*.buildlog
*.build

# checksums generated by build.sh / release tooling
*.sha256
SHA256SUMS

# live-build logs
build.log
wget-log*

# Raspberry Pi ARM64 build working directory (created by scripts/build-rpi4-arm64.sh)
/build/

# live-build copies/symlinks its stock hook set during `lb config`.
/config/hooks/live/0010-disable-kexec-tools.hook.chroot
/config/hooks/live/0050-disable-sysvinit-tmpfs.hook.chroot
/config/hooks/normal/*.hook.chroot

# editor / OS cruft
.DS_Store
*.swp
*~
__pycache__/
*.pyc
.aigency-worktrees/
