# Iron Linux - live-build artifacts and local build state.
# Everything under here is regenerated by ./build.sh / lb config / lb build
# and must never be committed.

# live-build working directories (created by `lb config`)
/config/binary
/config/bootstrap
/config/chroot
/config/common
/config/source
/config/rootfs

# live-build build/output directories (created by `lb build`)
/.build/
/cache/
/chroot/
/chroot.*/
/chroot.packages.*
/binary/
/binary.*
/local/

# ISO / image output
*.iso
*.img
*.squashfs*
*.zsync
*.contents
*.files
*.packages
*.buildlog
*.build

# checksums generated by build.sh
*.iso.sha256

# live-build logs
build.log

# live-build copies/symlinks its stock hook set during `lb config`.
/config/hooks/live/0010-disable-kexec-tools.hook.chroot
/config/hooks/live/0050-disable-sysvinit-tmpfs.hook.chroot
/config/hooks/normal/*.hook.chroot

# editor / OS cruft
.DS_Store
*.swp
*~
__pycache__/
*.pyc
.aigency-worktrees/
